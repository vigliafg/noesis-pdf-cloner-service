# Noesis PDF Cloner Service — reverse proxy (esempio nginx)
# TLS + upload grandi + streaming SSE senza buffering.

upstream noesis_api {
    server 127.0.0.1:18080;
    keepalive 16;
}

server {
    listen 80;
    server_name cloner.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name cloner.example.com;

    ssl_certificate     /etc/letsencrypt/live/cloner.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cloner.example.com/privkey.pem;

    # PDF fino a 500 MB (allineare a MAX_UPLOAD_MB)
    client_max_body_size 600m;
    client_body_timeout 600s;

    location / {
        proxy_pass http://noesis_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # SSE (log live): niente buffering e timeout lungo
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding on;
    }
}
