# Noesis PDF Cloner — Service · configurazione (esempio)
# Copiare in /etc/noesis/noesis.env e adattare.

# ── Ruolo e scalabilità ────────────────────────────────────────────────
# ROLE è impostato dai unit systemd (api / worker); qui solo i parametri comuni.
# Numero TOTALE di processi worker (usato per dividere le risorse tra i worker).
WORKER_COUNT=4
# AUTOSIZE=true: workers/concorrenza/processi motore calcolati dalla macchina.
AUTOSIZE=true
QUEUE_BACKEND=db

# Override manuali (opzionali, 0 = autosize)
# WORKERS=2
# PAGE_CONCURRENCY=2
# MAX_ENGINE_PROCS=4
# ENGINE_MEMORY_MB=800

# ── Rete ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=18080
# Uvicorn può scalare ORIZZONTALMENTE solo in ROLE=api (RUOLO worker condiviso).
UVICORN_WORKERS=2

# ── Percorsi ───────────────────────────────────────────────────────────
DATA_DIR=/var/lib/noesis-pdf-cloner
CACHE_ROOT=/var/lib/noesis-pdf-cloner/cache

# ── Limiti ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=500
MAX_QUEUE_SIZE=100
MAX_PAGES_PER_BLOCK=100
MAX_PAGES_TOTAL=5000
PAGE_TIMEOUT=900
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_JOBS_PER_HOUR=60
MIN_FREE_DISK_MB=2048
MIN_FREE_RAM_MB=512

# ── Pulizia (retention) ────────────────────────────────────────────────
JOB_RETENTION_HOURS=72
DOCUMENT_RETENTION_HOURS=24
THUMB_RETENTION_HOURS=168
JANITOR_INTERVAL_SECONDS=600

# ── Motore di traduzione ───────────────────────────────────────────────
# PDF2ZH_BIN=/opt/noesis-pdf-cloner-service/.venv2/bin/pdf2zh_next
# Chiave OpenRouter del *server*: opzionale. Con il BYOK (motore llm) gli utenti
# usano la propria chiave dal browser; qui puoi impostarne una come fallback.
# OPENROUTER_API_KEY=sk-or-...
PDF_LLM_MODEL=inception/mercury-2.5
# PDF_LLM_BASE_URL=https://openrouter.ai/api/v1

# ── Legale e interfaccia ───────────────────────────────────────────────
# HELP_URL=https://vigliafg.github.io/noesis-pdf-cloner-service/
# TERMS_VERSION=1.0
# REQUIRE_TERMS_ACCEPTANCE=false   # true quando esponi il servizio a terzi

# ── Prezzo commerciale per pagina (centesimi) ──────────────────────────
# Servizio gratuito (default): lascia 0. Per il motore LLM la stima mostra il
# costo stimato a carico dell'utente su OpenRouter. Imposta >0 solo per un'offerta
# a pagamento.
COST_CENTS_PER_PAGE_GOOGLE=0
COST_CENTS_PER_PAGE_BING=0
COST_CENTS_PER_PAGE_LLM=0
# (alias storico accettato: COST_CENTS_PER_PAGE_OPENAI)

# Stime di tempo per pagina (ms; 0 = default interno). Avanzate.
# ESTIMATE_MS_PER_PAGE_GOOGLE=0
# ESTIMATE_MS_PER_PAGE_BING=0
# ESTIMATE_MS_PER_PAGE_LLM=0

# ── Configurazione dalla pagina web (opzionale) ────────────────────────
# La pagina http://<host>:<porta>/settings è riservata alla macchina locale
# (e al computer che ospita Docker: riconosce da sé il gateway del container).
# Le richieste che arrivano da un reverse proxy sono rifiutate. Se serve
# consentire un indirizzo in più (es. un IP della LAN), elencalo qui.
# ADMIN_ALLOW_FROM=192.168.1.10,10.0.0.0/24
